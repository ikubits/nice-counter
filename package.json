{
  "name": "nice-counter",
  "version": "1.0.1",
  "description": "An Odometer.js-inspired animated counter Web Component with smooth easing and motion blur effect",
  "type": "module",
  "main": "dist/nice-counter.es.js",
  "module": "dist/nice-counter.es.js",
  "exports": {
    ".": {
      "import": "./dist/nice-counter.es.js",
      "require": "./dist/nice-counter.cjs.js"
    },
    "./es": "./dist/nice-counter.es.js",
    "./cjs": "./dist/nice-counter.cjs.js",
    "./iife": "./dist/nice-counter.iife.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.demo.config.js",
    "prepare": "npm run lint && npm run build",
    "preview": "vite preview",
    "serve": "serve docs/",
    "lint": "eslint src/"
  },
  "keywords": [
    "counter",
    "countup",
    "countdown",
    "odometer"
  ],
  "author": "ikubits",
  "license": "MIT",
  "devDependencies": {
    "@babel/eslint-parser": "^7.23.3",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^8.56.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
